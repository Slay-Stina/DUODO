@page "/counter"

@inject Blazored.LocalStorage.ILocalStorageService localStorage
@rendermode InteractiveServer

<h3>Local Storage Example</h3>

<input @bind-value="@inputData" />

<button @onclick="RemoveData">Remove Data</button>
<button @onclick="AddData">Add Data</button>
<button @onclick="RetrieveData">Retrieve Data</button>

<ul>
    <li>The retrieved data from the LocalStorage:</li>
    @foreach( var item in storedData)
    {
        <li>@item</li>
    }
</ul>

@code {
    private const string dataKey = "localStorageKey";

    private List<string>? storedData = new List<string>();
    private string? inputData;
    private List<string>? inputList = new List<string>();

    private async Task AddData()
    {
        if (!string.IsNullOrWhiteSpace(inputData))
        {
            inputList.Add(inputData);
            await StoreData();
        }
    }

    private async Task RemoveData()
    {
        if (inputList.Contains(inputData))
        {
            inputList.Remove(inputData);
            await StoreData();
        }
    }

    private async Task StoreData()
    {
        await localStorage.SetItemAsync(dataKey, inputList);
        inputData = "";
    }

    protected async Task OnAfterRenderAsync()
    {
        await RetrieveData();
    }

    private async Task RetrieveData()
    {
        storedData = await localStorage.GetItemAsync<List<string>>(dataKey);
    }

}